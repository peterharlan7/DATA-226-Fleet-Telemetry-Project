# Copy this file to .env and fill in your own values. .env is ignored by Git.

# 511 API key (free at 511.org/open-data/token)
API_511_KEY=your-511-org-api-key
# Optional: several keys, comma-separated, to poll faster (teammates' keys)
API_511_KEYS=
# Optional: separate key for the trip-updates feed
API_511_KEY_TRIPS=

# Kafka (docker-compose exposes it on 29092 for programs on your laptop)
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC_POSITIONS=vehicle-positions
KAFKA_TOPIC_TRIPS=trip-updates

# MongoDB (B11)
MONGO_URI=mongodb://localhost:27017

# Secret salt for hashing vehicle IDs (B13). Everyone must use the same value.
# Get it from Jason privately (never commit it). To generate a new one:
#   python -c "import secrets; print(secrets.token_hex(32))"
VEHICLE_ID_SALT=
